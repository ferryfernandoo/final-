{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ceo.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/search",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/search"
    },
    {
      "source": "/search/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/search/:path*"
    },
    {
      "source": "/api/v1/search",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/v1/search"
    },
    {
      "source": "/api/v1/images",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/v1/images"
    },
    {
      "source": "/api/v1/news",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/v1/news"
    },
    {
      "source": "/api/v1/suggest",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/suggest"
    },
    {
      "source": "/api/suggestions",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/suggestions"
    },
    {
      "source": "/api/suggestions/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/suggestions/:path*"
    },
    {
      "source": "/api/ai/stream",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/ai/stream"
    },
    {
      "source": "/api/news/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/news/:path*"
    },
    {
      "source": "/api/tokoh/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/tokoh/:path*"
    },
    {
      "source": "/api/geo/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/geo/:path*"
    },
    {
      "source": "/api/crawl/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/crawl/:path*"
    },
    {
      "source": "/api/economics/:path*",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/economics/:path*"
    },
    {
      "source": "/api/proxy-image",
      "destination": "https://depot-entrance-land-combining.trycloudflare.com/api/proxy-image"
    },
    {
      "source": "/api/:path*",
      "destination": "https://emacs-corn-accommodation-regarded.trycloudflare.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://emacs-corn-accommodation-regarded.trycloudflare.com/auth/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://emacs-corn-accommodation-regarded.trycloudflare.com/v1/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://emacs-corn-accommodation-regarded.trycloudflare.com/download/:path*"
    },
    {
      "source": "/watermarked/:path*",
      "destination": "https://emacs-corn-accommodation-regarded.trycloudflare.com/watermarked/:path*"
    },
    {
      "source": "/((?!assets/|ceo\\.jpg|robots\\.txt|sitemap\\.xml|favicon|logo|llms\\.txt|ai-info\\.json|google|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}