{
  "name": "nexus-search-crawler",
  "version": "1.0.0",
  "description": "Ultra-efficient manual search engine web crawler with PageRank and BM25 indexer",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=1536 --expose-gc src/server.js",
    "dev": "node --max-old-space-size=1536 --expose-gc --watch src/server.js",
    "build": "vite build",
    "dev:client": "vite",
    "tunnel": "bin\\cloudflared.exe tunnel --url http://localhost:3000",
    "tunnel:permanent": "node scripts/permanent_tunnel.js",
    "tunnel:client": "bin\\cloudflared.exe tunnel --url http://localhost:5173",
    "test-crawl": "node tests/test-crawler.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "localtunnel": "^2.0.2",
    "lucide-react": "^1.33.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
