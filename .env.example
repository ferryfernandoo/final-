# ============================================================================
# DeeperNova AI - Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` - it is gitignored. NEVER hardcode keys in source code.
# For Vercel: set these in Project Settings -> Environment Variables.
# ============================================================================

# --- FreeLLM Gateway & Free-Tier Upstream (server-side only) ---
FREELLM_API_URL=http://127.0.0.1:3005/v1/chat/completions
FREELLM_API_KEYS=            # comma-separated unified keys from FreeLLMAPI (http://localhost:3005)
FREELLM_API_KEY=
FREELLM_CHAT_MODEL=qwen2.5-vl-72b
FREELLM_AGENT_MODEL=nemotron-3-ultra-550b
FREELLM_IMAGE_GENERATIONS_URL=http://127.0.0.1:3005/v1/images/generations
FREELLM_IMAGE_EDITS_URL=http://127.0.0.1:3005/v1/images/edits

# Optional Direct Free-Tier Official Provider Keys (no credit card required)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GITHUB_MODELS_TOKEN=

# --- Search (server-side only) ---
SERPAPI_KEY=
DEEPERNOVA_SEARCH_API_URL=http://127.0.0.1:4000/api/v1
DEEPERNOVA_SEARCH_API_KEY=

# --- Session / Auth (server-side only) ---
SESSION_SECRET=

# --- Public URLs (safe to expose) ---
PUBLIC_BACKEND_URL=
PUBLIC_FRONTEND_URL=
ALLOWED_ORIGINS=

# --- Frontend (VITE_* is PUBLIC - embedded into the browser bundle!) ---
# Never put secret keys in VITE_* variables.
VITE_API_URL=
VITE_DEEPERNOVA_SEARCH_API_URL=/api/v1
VITE_SEARCH_ENGINE_URL=/search
VITE_ORDER_DTE_URL=
# Dev-only search key (only read in `vite dev`, never shipped to production)
VITE_DEEPERNOVA_SEARCH_API_KEY=
