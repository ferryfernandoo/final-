# ============================================================================
# DeeperNova AI - Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` - it is gitignored. NEVER hardcode keys in source code.
# For Vercel: set these in Project Settings -> Environment Variables.
# ============================================================================

# --- AI Upstream (server-side only) ---
TOKENMIX_API_KEYS=            # comma-separated: key1,key2,key3
TOKENMIX_API_KEY=
TOKENMIX_SECONDARY_API_KEY=
TOKENMIX_FALLBACK_API_KEY=
TOKENMIX_CHAT_API_URL=https://api.tokenmix.ai/v1/chat/completions
TOKENMIX_CHAT_MODEL=
DEEPSEEK_API_KEY=

# --- Search (server-side only) ---
SERPAPI_KEY=
DEEPERNOVA_SEARCH_API_URL=http://127.0.0.1:4000/api/v1
DEEPERNOVA_SEARCH_API_KEY=

# --- Session / Auth (server-side only) ---
SESSION_SECRET=

# --- Public URLs (safe to expose) ---
PUBLIC_BACKEND_URL=
PUBLIC_FRONTEND_URL=
ALLOWED_ORIGINS=

# --- Frontend (VITE_* is PUBLIC - embedded into the browser bundle!) ---
# Never put secret keys in VITE_* variables.
VITE_API_URL=
VITE_DEEPERNOVA_SEARCH_API_URL=/api/v1
VITE_SEARCH_ENGINE_URL=/search
VITE_ORDER_DTE_URL=
# Dev-only search key (only read in `vite dev`, never shipped to production)
VITE_DEEPERNOVA_SEARCH_API_KEY=

