{
  "appId": "com.dpn.search",
  "appName": "DPN Search",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://deepernova.com/search",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "deepernova.com",
      "*.deepernova.com",
      "*.trycloudflare.com"
    ]
  },
  "android": {
    "allowMixedContent": true
  }
}
