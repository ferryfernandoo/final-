{
  "name": "chat-bot",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node server/server.js",
    "cap:build": "node -e \"fs.rmSync('dist', {recursive: true, force: true}); fs.rmSync('android/app/src/main/assets/public', {recursive: true, force: true});\" && vite build && node -e \"try{fs.unlinkSync('dist/ceo.jpg');}catch(e){}\" && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "build:apk": "npm run cap:build && cd android && gradlew.bat assembleDebug && copy /Y app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\deepernova-ai.apk",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "build:exe": "vite build && node -e \"try{fs.unlinkSync('dist/ceo.jpg');}catch(e){}\" && npx electron-packager . DeeperNovaAI --platform=win32 --arch=x64 --out=dist-win --overwrite --prune=true --ignore=\"^/(src|public|android|server|\\.git|\\.vscode)\""
  },
  "build": {
    "appId": "com.deepernova.app",
    "productName": "DeeperNova AI & Office",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "files": [
      "dist/**/*",
      "!dist/ceo.jpg",
      "electron/**/*",
      "!node_modules/better-sqlite3/**",
      "!node_modules/bcrypt/**"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@openrouter/sdk": "^0.12.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "jszip": "^3.10.1",
    "kan": "^0.0.1",
    "katex": "^0.16.45",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfjs-dist": "^5.6.205",
    "pptx-parser": "^1.1.7-beta.9",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
